NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/job-portal

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Set to true once real SMTP creds are filled in below to require email verification before login
REQUIRE_EMAIL_VERIFICATION=false

# SMTP (leave blank in dev to log emails to console instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Job Portal <no-reply@jobportal.com>"

# Cloudinary (resume/file storage) - optional, falls back to local /uploads if blank
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI (resume parsing embeddings + RAG chatbot) - optional, matching falls back to keyword overlap if blank
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
